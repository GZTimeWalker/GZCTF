<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <CollectCoverage>true</CollectCoverage>
    <Configurations>Debug;Release</Configurations>
    <ReleaseVersion>1.8.7</ReleaseVersion>
    <EnablePreviewFeatures>True</EnablePreviewFeatures>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="SimpleBase" />
    <PackageReference Include="Testcontainers.K3s" />
    <PackageReference Include="Testcontainers.Minio" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="xunit.runner.console" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="coverlet.msbuild" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GZCTF\GZCTF.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    These suites exercise the removed competition, team, scoreboard, and legacy
    repository write paths. Keep the source as migration reference, but do not
    include obsolete behavior in the Learning platform's default test assembly.
  -->
  <ItemGroup>
    <Compile Remove="Tests/Api/AdvancedGameMechanicsTests.cs" />
    <Compile Remove="Tests/Api/DetailedGameScoringTests.cs" />
    <Compile Remove="Tests/Api/EditControllerTests.cs" />
    <Compile Remove="Tests/Api/GameExportImportTests.cs" />
    <Compile Remove="Tests/Api/GameJoinTests.cs" />
    <Compile Remove="Tests/Api/GameWorkflowTests.cs" />
    <Compile Remove="Tests/Api/PracticeModeDeadlineTests.cs" />
    <Compile Remove="Tests/Api/ScoreboardCalculationTests.cs" />
    <Compile Remove="Tests/Api/TeamManagementTests.cs" />
    <Compile Remove="Tests/Database/DatabaseContextTests.cs" />
    <Compile Remove="Tests/Repository/DivisionRepositoryTests.cs" />
    <Compile Remove="Tests/Repository/GameChallengeRepositoryTests.cs" />
    <Compile Remove="Tests/Repository/GameRepositoryTests.cs" />
    <Compile Remove="Tests/Repository/ParticipationRepositoryTests.cs" />
    <Compile Remove="Tests/Repository/SubmissionRepositoryTests.cs" />
    <Compile Remove="Tests/Repository/TeamRepositoryTests.cs" />
  </ItemGroup>


</Project>
